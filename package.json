{
  "name": "silk",
  "displayName": "Silk",
  "description": "Silk language support for Visual Studio Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "silk-lang",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/silk-lang/silk-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/silk-lang/silk-vscode/issues"
  },
  "homepage": "https://github.com/silk-lang/silk-vscode#readme",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "silk"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "silk",
        "aliases": [
          "Silk",
          "silk"
        ],
        "extensions": [
          ".silk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silk",
        "scopeName": "source.silk",
        "path": "./syntaxes/silk.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "vscode-tmgrammar-test \"test/grammar/**/*.silk\"",
    "package": "vsce package --no-dependencies",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "vsce publish --azure-credential --skip-duplicate --packagePath silk.vsix"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vscode/vsce": "4.0.0",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "packageManager": "bun@1.4.2"
}
