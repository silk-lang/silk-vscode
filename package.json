{
  "name": "silk",
  "displayName": "Silk",
  "description": "Silk language support for Visual Studio Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "silk-lang",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/silk-lang/silk-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/silk-lang/silk-vscode/issues"
  },
  "homepage": "https://github.com/silk-lang/silk-vscode#readme",
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "silk"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "silk",
        "aliases": [
          "Silk",
          "silk"
        ],
        "extensions": [
          ".silk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "silk",
        "scopeName": "source.silk",
        "path": "./syntaxes/silk.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "silk.restartServer",
        "title": "Restart Language Server",
        "category": "Silk"
      }
    ],
    "configuration": {
      "title": "Silk",
      "properties": {
        "silk.path": {
          "type": "string",
          "default": "silk",
          "description": "The Silk compiler that runs the language server (`silk lsp`), as a path or a command on PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-tmgrammar-test \"test/grammar/**/*.silk\"",
    "package": "bun run build && vsce package --no-dependencies",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "vsce publish --azure-credential --skip-duplicate --packagePath silk.vsix",
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.0",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "packageManager": "bun@1.4.2"
}
